<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="WordPress Plugin PHPMD Ruleset"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">

    <description>WordPress-compatible PHPMD ruleset for code quality and naming conventions.</description>

    <!--
        Non-production paths. The composer script and the CI job pass the same
        list on the command line.
    -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/.private/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>
    <exclude-pattern>*/stubs/*</exclude-pattern>

    <!-- Clean Code Rules (with WordPress exceptions) -->
    <rule ref="rulesets/cleancode.xml">
        <!-- WordPress code uses core classes without namespace imports. -->
        <exclude name="MissingImport"/>
        <!-- Added again below, with the one class that is reached statically. -->
        <exclude name="StaticAccess"/>
    </rule>

    <rule ref="rulesets/cleancode.xml/StaticAccess">
        <properties>
            <!-- The plugin coordinator is reached through its static instance() accessor. -->
            <property name="exceptions" value="Optimizations_Ace_Mc"/>
        </properties>
    </rule>

    <!-- Code Size Rules (default thresholds) -->
    <rule ref="rulesets/codesize.xml"/>

    <!-- Controversial Rules (with WordPress naming exceptions) -->
    <rule ref="rulesets/controversial.xml">
        <!-- WordPress uses snake_case and Snake_Case_Class_Names. -->
        <exclude name="CamelCaseClassName"/>
        <exclude name="CamelCaseMethodName"/>
        <exclude name="CamelCaseVariableName"/>
        <exclude name="CamelCaseParameterName"/>
        <exclude name="CamelCasePropertyName"/>
    </rule>

    <!-- Design Rules -->
    <rule ref="rulesets/design.xml"/>

    <!-- Naming Rules. The camelCase rules are in the controversial ruleset. -->
    <rule ref="rulesets/naming.xml">
        <!-- Added again below with a limit that fits prefixed WordPress names. -->
        <exclude name="LongClassName"/>
    </rule>

    <rule ref="rulesets/naming.xml/LongClassName">
        <properties>
            <!-- Class names start with the plugin prefix; the longest has 46 characters. -->
            <property name="maximum" value="50"/>
        </properties>
    </rule>

    <!-- Unused Code Rules (always enforce) -->
    <rule ref="rulesets/unusedcode.xml"/>

</ruleset>
